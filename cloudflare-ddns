#!/usr/bin/env bash
set -euo pipefail

readonly CLOUDFLARE_API_URL='https://api.cloudflare.com/client/v4'

log() {
  printf '%s %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"
}

die() {
  log "ERROR: $*" >&2
  exit 1
}

validate_config() {
  : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN environment variable is required}"
  : "${CLOUDFLARE_ZONE_ID:?CLOUDFLARE_ZONE_ID environment variable is required}"
  : "${CLOUDFLARE_DNS_RECORDS:?CLOUDFLARE_DNS_RECORDS environment variable is required}"

  local dependency
  for dependency in curl jq; do
    command -v "$dependency" >/dev/null 2>&1 || die "Required command not found: $dependency"
  done
  [[ "$CLOUDFLARE_ZONE_ID" =~ ^[[:xdigit:]]{32}$ ]] || die 'CLOUDFLARE_ZONE_ID must be a 32-character hexadecimal zone ID'
}

http_request() {
  curl --fail --silent --show-error \
    --connect-timeout 10 --max-time 30 \
    --retry 3 --retry-delay 2 --retry-max-time 120 "$@"
}

cloudflare_request() {
  local path="$1" response
  shift
  response="$(http_request "$CLOUDFLARE_API_URL$path" \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
    -H 'Accept: application/json' "$@")" || {
    log "ERROR: Cloudflare HTTP request failed: $path" >&2
    return 1
  }
  if ! jq -e '.success == true' >/dev/null <<< "$response"; then
    log "ERROR: Cloudflare API request failed: $path" >&2
    jq -r '.errors[]?.message' <<< "$response" >&2
    return 1
  fi
  printf '%s\n' "$response"
}

get_public_ipv4() {
  local address octet
  local -a octets
  address="$(http_request -4 https://ifconfig.me/ip)" || return 1
  address="${address//$'\r'/}"
  [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "Invalid public IPv4 address: $address"
  IFS=. read -r -a octets <<< "$address"
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || die "Invalid public IPv4 address: $address"
  done
  printf '%s\n' "$address"
}

list_dns_records() {
  local records='[]' page=1 response total_pages
  while true; do
    response="$(cloudflare_request \
      "/zones/$CLOUDFLARE_ZONE_ID/dns_records?type=A&per_page=5000&page=$page")" || return 1
    # Feed JSON through stdin so large zones do not hit the argument-size limit.
    records="$(printf '%s\n%s\n' "$records" "$response" | jq -cse '.[0] + .[1].result')" || return 1
    total_pages="$(jq -r '.result_info.total_pages // 1' <<< "$response")" || return 1
    if (( page >= total_pages )); then break; fi
    page=$((page + 1))
  done
  printf '%s\n' "$records"
}

update_dns_record() {
  local record_id="$1" address="$2" payload
  payload="$(jq -nc --arg address "$address" '{content: $address}')" || return 1
  # PATCH only the address, preserving every other record setting.
  cloudflare_request "/zones/$CLOUDFLARE_ZONE_ID/dns_records/$record_id" \
    -X PATCH -H 'Content-Type: application/json' --data "$payload" >/dev/null
}

main() {
  validate_config
  local host_list="$CLOUDFLARE_DNS_RECORDS"
  host_list="${host_list//,/ }"
  host_list="${host_list//$'\n'/ }"
  local -a hosts
  read -r -a hosts <<< "$host_list"
  (( ${#hosts[@]} > 0 )) || die 'CLOUDFLARE_DNS_RECORDS must contain at least one host'

  local address records record_name record record_id previous_address
  local failed=0 matched=0
  address="$(get_public_ipv4)"
  log "Public IPv4: $address"
  records="$(list_dns_records)"

  for record_name in "${hosts[@]}"; do
    record_name="${record_name%.}"
    record_name="${record_name,,}"
    record="$(jq -c --arg name "$record_name" \
      'map(select(.type == "A" and .name == $name)) | .[0] // empty' <<< "$records")"
    if [[ -z "$record" ]]; then
      log "WARNING: Skipping missing A record: $record_name" >&2
      continue
    fi
    matched=$((matched + 1))
    record_id="$(jq -r '.id' <<< "$record")"
    previous_address="$(jq -r '.content' <<< "$record")"
    if [[ "$previous_address" == "$address" ]]; then
      log "No change: $record_name"
      continue
    fi
    log "Updating $record_name: $previous_address -> $address"
    if update_dns_record "$record_id" "$address"; then
      log "Updated: $record_name"
    else
      log "ERROR: Failed to update: $record_name" >&2
      failed=1
    fi
  done
  (( matched > 0 )) || die 'No configured A records were found'
  return "$failed"
}

main "$@"
